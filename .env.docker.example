# Copy to .env.docker and edit, then:
#   docker compose --env-file .env.docker up -d --build
#
# These values configure the containers. The application's own configuration
# lives in the storage volume at storage/.env, which the entrypoint seeds from
# these on first boot and keeps in sync afterwards.

# Public address of the site, as seen through your reverse proxy.
APP_URL=http://localhost:8080

DB_DATABASE=blessingskin
DB_USERNAME=blessingskin
# Required. Used for both the MariaDB user and the application's connection.
DB_PASSWORD=
