{
  "extends": "@tsconfig/vite-react",
  "compilerOptions": {
    "jsxImportSource": "@emotion/react",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./resources/assets/src/*"
      ]
    },
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": false
  },
  "include": [
    "resources/assets/src",
    "resources/assets/tests",
    "tools",
    "vite.config.ts",
    "vitest.config.ts",
    "eslint.config.js"
  ]
}
